---
import Photo from "../../components/Photo.astro";
import type { Gallery } from "../../lib/types";
import { galleryName } from "../../lib/gallery-name";

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const name = galleryName(gallery);

// Photos are sized by height, so derive width from aspect ratio. Keep 72px in sync with --head.
const heightSized = (p: { width: number; height: number }) =>
  `calc((100vh - 72px) * ${(0.92 * (p.width / p.height)).toFixed(4)})`;
---

<section
  class="stage"
  data-carousel
  data-gallery-name={name}
  data-cover={gallery.cover}
  aria-roledescription="carousel"
  aria-label={`${name} gallery`}
>
  <ul class="track" data-track>
    {
      gallery.photos.map((photo, i) => (
        <li class="slide">
          <Photo
            photo={photo}
            priority={i === 0}
            sizes={heightSized(photo)}
            class="slide-photo"
          />
        </li>
      ))
    }
  </ul>

  <button
    class="arrow prev"
    type="button"
    data-prev
    aria-label="Previous photo"
    hidden
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path d="m15 5-7 7 7 7"></path></svg
    >
  </button>
  <button
    class="arrow next"
    type="button"
    data-next
    aria-label="Next photo"
    hidden
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path d="m9 5 7 7-7 7"></path></svg
    >
  </button>

  <p class="cap" data-cap aria-live="polite">
    {name} &nbsp;·&nbsp; 1 / {gallery.photos.length}
  </p>
</section>

<script>
  import { initCarousel } from "./carousel";
  document
    .querySelectorAll<HTMLElement>("[data-carousel]")
    .forEach((el) => initCarousel(el));
</script>

<style>
  .stage {
    height: calc(100dvh - var(--head));
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
  }

  /* No-JS fallback: a native scroll strip. */
  .track {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0;
    height: 92%;
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .slide {
    flex: 0 0 auto;
    height: 100%;
    position: relative;
    background: #f0eee9;
    scroll-snap-align: center;
  }

  .slide :global(.slide-photo) {
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: cover;
  }

  /* Set by carousel.ts once enhanced. */
  .stage[data-enhanced] .track {
    width: auto;
    overflow: visible;
    will-change: transform;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
    cursor: grab;
  }
  .stage[data-enhanced] .track.drag {
    cursor: grabbing;
    transition: none;
  }

  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 54px;
    height: 54px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--hair);
    backdrop-filter: blur(6px);
    cursor: pointer;
    display: grid;
    place-items: center;
    color: var(--ink);
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .arrow:hover {
    background: #fff;
    transform: translateY(-50%) scale(1.05);
  }
  .arrow:active {
    transform: translateY(-50%) scale(0.96);
  }
  .arrow svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 1.5;
    fill: none;
  }
  .arrow.prev {
    left: clamp(14px, 2.2vw, 38px);
  }
  .arrow.next {
    right: clamp(14px, 2.2vw, 38px);
  }

  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    text-align: center;
    z-index: 3;
    font-size: 13px;
    color: var(--dim);
    letter-spacing: 0.03em;
    pointer-events: none;
  }

  @media (max-width: 620px) {
    .arrow {
      width: 44px;
      height: 44px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage[data-enhanced] .track {
      transition: none;
    }
  }
</style>
