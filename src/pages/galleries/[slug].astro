---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GalleryView from "../../components/GalleryView.astro";
import { getGalleries } from "../../lib/content-source";
import { galleryName } from "../../lib/gallery-name";
import { ogImage } from "../../lib/og-image";
import { SITE } from "../../site.config";

export const getStaticPaths = (async () => {
  const galleries = await getGalleries();
  return galleries.slice(1).map((gallery, i) => ({
    params: { slug: gallery.slug },
    props: { gallery, galleries, number: i + 2 },
  }));
}) satisfies GetStaticPaths;

const { gallery, galleries, number } = Astro.props;
---

<BaseLayout
  title={`${galleryName(gallery)} — ${SITE.name}`}
  description={gallery.intro ?? `Film photography from ${gallery.title}.`}
  image={ogImage(gallery)}
>
  <GalleryView galleries={galleries} gallery={gallery} number={number} />
</BaseLayout>
