---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryView from "../components/GalleryView.astro";
import { getGalleries } from "../lib/content-source";
import { ogImage } from "../lib/og-image";
import { SITE } from "../site.config";

const galleries = await getGalleries();
const first = galleries[0];

if (!first) {
  throw new Error(
    "No galleries found. Add a YAML file under src/content/galleries/.",
  );
}
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={first.intro ?? SITE.description}
  image={ogImage(first)}
>
  <GalleryView galleries={galleries} gallery={first} />
</BaseLayout>
