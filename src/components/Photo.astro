---
import type { Photo } from "../lib/types";
import { MAX_EDGE, photoUrl } from "../lib/cloudinary";

interface Props {
  photo: Photo;
  priority?: boolean;
}

const { photo, priority = false } = Astro.props;
const { width, height } = photo;

const longEdgeScale = Math.min(1, MAX_EDGE / Math.max(width, height));
const maxWidth = Math.round(width * longEdgeScale);
const widths = [...new Set([480, 800, 1200, 1600, maxWidth])]
  .filter((w) => w <= maxWidth)
  .sort((a, b) => a - b);
const srcset = widths.map((w) => `${photoUrl(photo, w)} ${w}w`).join(", ");

// Photos are sized by height, so derive width from aspect ratio. Keep 72px in sync with --head.
const sizes = `calc((100vh - 72px) * ${(0.92 * (width / height)).toFixed(4)})`;
---

<img
  class="photo"
  src={photoUrl(photo, widths.at(-1)!)}
  srcset={srcset}
  sizes={sizes}
  width={maxWidth}
  height={Math.round(height * longEdgeScale)}
  alt={photo.alt}
  style={`aspect-ratio:${width}/${height}`}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding="async"
  draggable="false"
  data-protected
/>

<style>
  .photo {
    height: 100%;
    width: auto;
    object-fit: cover;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
  }
</style>
