---
import { Image } from "astro:assets";
import type { Photo } from "../lib/types";

interface Props {
  photo: Photo;
  priority?: boolean;
}

const { photo, priority = false } = Astro.props;
const { src } = photo;

const widths = [...new Set([480, 800, 1200, 1600, 2048, src.width])]
  .filter((w) => w <= src.width)
  .sort((a, b) => a - b);

// Photos are sized by height, so derive width from aspect ratio. Keep 72px in sync with --head.
const displayWidth = `calc((100vh - 72px) * ${(0.92 * (src.width / src.height)).toFixed(4)})`;
---

<Image
  class="photo"
  src={src}
  alt={photo.alt}
  widths={widths}
  sizes={displayWidth}
  style={`aspect-ratio:${src.width}/${src.height}`}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding="async"
  draggable={false}
/>

<style>
  .photo {
    height: 100%;
    width: auto;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
