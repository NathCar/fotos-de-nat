---
import { Image } from "astro:assets";
import type { Photo } from "../lib/types";

interface Props {
  photo: Photo;
  /** First image in the viewport should load eagerly with high priority. */
  priority?: boolean;
}

const { photo, priority = false } = Astro.props;
const { src } = photo;

// Responsive widths, capped at the image's real width so we never upscale.
const widths = [...new Set([480, 800, 1200, 1600, 2048, src.width])]
  .filter((w) => w <= src.width)
  .sort((a, b) => a - b);

// The filmstrip sizes photos by HEIGHT (.photo is height:100% of a slide that
// is 92% of the stage = 100dvh - --head[72px]); width then follows the aspect
// ratio. A viewport-width `sizes` (e.g. 45vw) badly under-reports the real
// width of landscape photos, so the browser picks a too-small file and upscales
// them. Describe the true height-driven width instead. 100vh (>= 100dvh) biases
// slightly large, i.e. toward sharper. Keep in sync with --head in global.css.
const displayWidth = `calc((100vh - 72px) * ${(0.92 * (src.width / src.height)).toFixed(4)})`;
---

<Image
  class="photo"
  src={src}
  alt={photo.alt}
  widths={widths}
  sizes={displayWidth}
  style={`aspect-ratio:${src.width}/${src.height}`}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding="async"
  draggable={false}
/>

<style>
  .photo {
    height: 100%;
    width: auto;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
