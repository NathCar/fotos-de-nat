---
import type { Photo } from "../lib/types";
import { MAX_EDGE, photoUrl } from "../lib/cloudinary";

interface Props {
  photo: Photo;
  priority?: boolean;
  /** The photo's displayed width, for picking a file size. Defaults to full width. */
  sizes?: string;
  class?: string;
}

const {
  photo,
  priority = false,
  sizes = "100vw",
  class: className,
} = Astro.props;
const { width, height } = photo;

const longEdgeScale = Math.min(1, MAX_EDGE / Math.max(width, height));
const maxWidth = Math.round(width * longEdgeScale);
const widths = [...new Set([480, 800, 1200, 1600, maxWidth])]
  .filter((w) => w <= maxWidth)
  .sort((a, b) => a - b);
const srcset = widths.map((w) => `${photoUrl(photo, w)} ${w}w`).join(", ");
---

<img
  class:list={["photo", className]}
  src={photoUrl(photo, widths.at(-1)!)}
  srcset={srcset}
  sizes={sizes}
  width={maxWidth}
  height={Math.round(height * longEdgeScale)}
  alt={photo.alt}
  style={`aspect-ratio:${width}/${height}`}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding="async"
  draggable="false"
  data-protected
/>

<style>
  .photo {
    max-width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
  }
</style>
