---
import type { Photo } from "../lib/types";

interface Props {
  photo: Photo;
  /** First image in the viewport should load eagerly with high priority. */
  priority?: boolean;
}

const { photo, priority = false } = Astro.props;

/**
 * Placeholder images come from picsum.photos. We request WebP and offer a 2×
 * variant for high-DPI screens. When real images move into the repo, replace
 * this component's <img> with astro:assets <Image> for build-time AVIF/WebP.
 */
function picsumVariant(src: string, scale: number): string {
  const m = src.match(/^(https:\/\/picsum\.photos\/seed\/[^/]+)\/(\d+)\/(\d+)$/);
  if (!m) return src;
  const [, base, w, h] = m;
  return `${base}/${Number(w) * scale}/${Number(h) * scale}.webp`;
}

const src1x = picsumVariant(photo.src, 1);
const src2x = picsumVariant(photo.src, 2);
const srcset = src1x !== photo.src ? `${src1x} 1x, ${src2x} 2x` : undefined;
---

<img
  class="photo"
  src={src1x}
  srcset={srcset}
  width={photo.width}
  height={photo.height}
  alt={photo.alt}
  style={`aspect-ratio:${photo.width}/${photo.height}`}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding="async"
  draggable="false"
/>

<style>
  .photo {
    height: 100%;
    width: auto;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
