---
// Minimal footer. The design is intentionally chrome-free, so this is a single
// visually-hidden landmark that keeps the document well-structured for SEO and
// assistive tech without adding visual weight to the full-bleed layout.
import { SITE } from "../site.config";
const year = new Date().getFullYear();
---

<footer class="visually-hidden">
  <p>© {year} {SITE.name}. Film photography.</p>
</footer>
