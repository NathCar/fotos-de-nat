---
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { TEMPLATES } from "../templates";
import type { Gallery } from "../lib/types";

interface Props {
  galleries: Gallery[];
  gallery: Gallery;
}

const { galleries, gallery } = Astro.props;
const Template = TEMPLATES[gallery.template];
---

<SiteHeader galleries={galleries} currentSlug={gallery.slug} />
<main>
  <Template gallery={gallery} />
</main>
<SiteFooter />
