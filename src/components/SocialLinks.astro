---
import { SITE } from "../site.config";

const { instagram, x, email } = SITE.social;
const mailto = email ? `mailto:${email}` : "";
---

<div class="social">
  {
    instagram && (
      <a href={instagram} aria-label="Instagram" rel="me noopener" target="_blank">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none" />
        </svg>
      </a>
    )
  }
  {
    x && (
      <a href={x} aria-label="X" rel="me noopener" target="_blank">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.2 3h2.9l-6.4 7.3L22 21h-5.9l-4.6-6-5.3 6H3.3l6.8-7.8L2.5 3h6l4.2 5.5L18.2 3Zm-1 16h1.6L7.9 4.6H6.2L17.2 19Z" />
        </svg>
      </a>
    )
  }
  {
    email && (
      <a href={mailto} aria-label="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3.5 6.5 8.5 6 8.5-6" />
        </svg>
      </a>
    )
  }
</div>

<style>
  .social {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .social a {
    color: var(--ink);
    opacity: 0.85;
    line-height: 0;
    transition: opacity 0.2s;
  }
  .social a:hover {
    opacity: 0.5;
  }
  .social :global(svg) {
    width: 18px;
    height: 18px;
  }
  @media (max-width: 620px) {
    .social {
      display: none;
    }
  }
</style>
